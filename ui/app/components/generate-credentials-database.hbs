<Page::Header @title={{@roleName}}>
  <:breadcrumbs>
    <Page::Breadcrumbs @breadcrumbs={{this.breadcrumbs}} />
  </:breadcrumbs>
</Page::Header>

{{! ---------------------------------------------------------------- }}
{{! STEP 1 — Collect justification (only for approval-required paths) }}
{{! ---------------------------------------------------------------- }}
{{#if (and @requiresApproval (not this.hasRequested))}}
  <div class="box is-fullwidth is-marginless">
    {{#if this.fetchError}}
      <Hds::Alert @type="inline" @color="critical" class="has-bottom-margin-m" as |A|>
        <A.Title>Request failed</A.Title>
        <A.Description>{{this.errorTitle}}</A.Description>
      </Hds::Alert>
    {{/if}}

    <form {{on "submit" this.requestCredentials}} data-test-justification-form>
      <div class="field">
        <label class="label" for="justification-input">
          Justification
          <span class="has-text-danger" aria-label="required">*</span>
        </label>
        <div class="control">
          <textarea
            id="justification-input"
            class="textarea"
            placeholder="Why do you need these credentials? Approvers will see this."
            maxlength="1000"
            rows="3"
            value={{this.justification}}
            {{on "input" this.updateJustification}}
            data-test-justification-input
          ></textarea>
        </div>
        <p class="help">Required. Max 1&thinsp;000 characters. Visible to approvers.</p>
      </div>

      <Hds::Button
        @text="Request Credentials"
        @color="primary"
        @icon="arrow-right"
        @iconPosition="trailing"
        type="submit"
        disabled={{not this.justificationTrimmed}}
        data-test-request-credentials-btn
      />
    </form>
  </div>
{{/if}}

{{! ---------------------------------------------------------------- }}
{{! STEP 2 — Show credential result                                   }}
{{! ---------------------------------------------------------------- }}
{{#if this.hasRequested}}

  {{! Loading spinner while the initial fetch is in flight }}
  {{#if this.isLoading}}
    <div class="box is-fullwidth has-text-centered has-top-bottom-margin" data-test-credentials-loading>
      <Hds::Icon @name="loading" @isAnimated={{true}} @size="24" />
      <span class="has-left-margin-s">Generating credentials…</span>
    </div>

  {{else}}
    <div class={{if this.model.roleType "box is-fullwidth is-sideless is-marginless"}}>

      {{! Fetch returned an error (role not found, permission denied, etc.) }}
      {{#unless this.model.roleType}}
        <Page::Error @error={{this.model}} @titleTag="h2">
          <:customFooter as |AppState|>
            <AppState.Footer as |F|>
              <F.LinkStandalone
                @iconPosition="trailing"
                @icon="docs-link"
                @text="Database documentation"
                @href={{doc-link "/vault/api-docs/secret/databases"}}
              />
            </AppState.Footer>
          </:customFooter>
        </Page::Error>
      {{/unless}}

      {{! APPROVAL WORKFLOW — denied or expired }}
      {{#if this.pollError}}
        <Hds::Alert @type="inline" @color="critical" class="has-top-bottom-margin" data-test-credentials-denied as |A|>
          <A.Title>Request Not Fulfilled</A.Title>
          <A.Description>{{this.pollError}}</A.Description>
        </Hds::Alert>
      {{/if}}

      {{! APPROVAL WORKFLOW — awaiting approval (auto-polling) }}
      {{#if this.isPending}}
        <Hds::Alert @type="inline" @color="highlight" class="has-top-bottom-margin" data-test-credentials-pending as |A|>
          <A.Title>Waiting for Approval</A.Title>
          <A.Description>
            Your credential request is pending approval.
            This page will update automatically once an approver reviews it.
          </A.Description>
          <A.Description>
            <strong>Request ID:</strong>
            <code>{{this.model.requestId}}</code>
          </A.Description>
        </Hds::Alert>
        <div class="has-top-bottom-margin" data-test-credentials-pending-spinner>
          <Hds::Icon @name="loading" @isAnimated={{true}} @size="24" />
          <span class="has-left-margin-s">Waiting for approval…</span>
        </div>
      {{/if}}

      {{#if (and (not this.isPending) (not this.model.errors) (eq this.model.roleType "dynamic") this.model.username)}}
        <Hds::Alert @type="inline" @color="warning" class="has-top-bottom-margin" data-test-credentials-warning as |A|>
          <A.Title>Warning</A.Title>
          <A.Description>
            You will not be able to access these credentials later, so please copy them now.
          </A.Description>
        </Hds::Alert>
      {{/if}}

      {{! DYNAMIC ROLE }}
      {{#if (and (not this.isPending) (eq this.model.roleType "dynamic") this.model.username)}}
        <InfoTableRow @label="Username" @value={{this.model.username}}>
          <MaskedInput @value={{this.model.username}} @name="Username" @displayOnly={{true}} @allowCopy={{true}} />
        </InfoTableRow>
        <InfoTableRow @label="Password" @value={{this.model.password}}>
          <MaskedInput @value={{this.model.password}} @name="Password" @displayOnly={{true}} @allowCopy={{true}} />
        </InfoTableRow>
        <InfoTableRow @label="Lease ID" @value={{this.model.leaseId}} />
        <InfoTableRow @label="Lease Duration" @value={{format-duration this.model.leaseDuration}} />
      {{/if}}

      {{! STATIC ROLE }}
      {{#if (and (eq this.model.roleType "static") this.model.username)}}
        <InfoTableRow
          @label="Last Vault rotation"
          @value={{date-format this.model.lastVaultRotation "MMMM d yyyy, h:mm:ss a"}}
          @tooltipText={{this.model.lastVaultRotation}}
          @addCopyButton={{true}}
        />
        <InfoTableRow @label="Password" @value={{this.model.password}}>
          <MaskedInput @value={{this.model.password}} @name="Password" @displayOnly={{true}} @allowCopy={{true}} />
        </InfoTableRow>
        <InfoTableRow @label="Username" @value={{this.model.username}} />
        <InfoTableRow @label="Rotation Period" @value={{format-duration this.model.rotationPeriod}} />
        <InfoTableRow @label="Time Remaining" @value={{format-duration this.model.ttl}} />
      {{/if}}
    </div>
  {{/if}}

{{/if}}

<div class="has-top-bottom-margin">
  <Hds::Button @text="Back" {{on "click" (action "redirectPreviousPage")}} />
</div>
